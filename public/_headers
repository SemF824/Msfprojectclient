/*
  # Empêche l'inclusion du site dans des iframes (Anti-Clickjacking)
  X-Frame-Options: DENY
  # Bloque le reniflage de type MIME
  X-Content-Type-Options: nosniff
  # Protection contre les fuites de referrer
  Referrer-Policy: strict-origin-when-cross-origin
  # Bloque l'accès aux fonctionnalités sensibles non requises
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # Content Security Policy stricte adaptée au projet MSF Congo
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://assets.calendly.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https: https://api.89.167.127.146.sslip.io; connect-src 'self' https://api.89.167.127.146.sslip.io wss://api.89.167.127.146.sslip.io https://*.supabase.co wss://*.supabase.co https://www.google.com https://api.calendly.com https://challenges.cloudflare.com https://*.ingest.de.sentry.io https://*.sentry.io; frame-src 'self' https://www.google.com https://calendly.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self';

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable